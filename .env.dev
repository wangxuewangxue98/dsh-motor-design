# Motor-AI 开发环境配置 (DEV)
# 版本: 2.05.03-dev | 更新时间: 2026-07-29 06:46
# 用途: 开发者日常调试，可随意修改，支持热重载

# ---- 环境 ----
MOTOR_ENV=dev

# ---- 系统版本 ----
SYSTEM_NAME=Motor-AI
SYSTEM_VERSION=2.05.03
VERSION_DATE=2026-07-29 06:46

# ---- Flask ----
FLASK_PORT=5000
FLASK_DEBUG=true
BIND_HOST=0.0.0.0

# ---- 数据库 ----
DB_PATH=D:\MotorDesign\KnowledgeBase\designs_dev.db

# ---- 本地模型 ----
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_MODEL_NAME=qwen2.5:3b-instruct-q4_K_M
USE_GPU=true

# ---- 云端模型 (DeepSeek) ----
# 调试版允许云端 API (需填入真实 key)
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
CLOUD_MODEL_NAME=deepseek-chat
ALLOW_CLOUD_API=true

# ---- Motor-CAD ----
MOTORCAD_EXE_PATH=D:\Motor-CAD\11_1_5\Motor-CAD_11_1_5.exe
MOTORCAD_INSTALL_DIR=D:\Motor-CAD\11_1_5
MOTORCAD_PROGID=MotorCAD.AppAutomation
MOTORCAD_USE_MODE=auto
MOTORCAD_TEMPLATE_FILE=Templates.mot

# ---- 多租户预留 ----
CLIENT_SECRET=
