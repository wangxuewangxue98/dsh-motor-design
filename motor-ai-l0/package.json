{
  "name": "dsh-motor-ai-l0",
  "version": "0.2.9",
  "type": "module",
  "main": "./index.mjs",
  "description": "电机AI辅助设计软件插件 · 覆盖电机设计全流程（需求解析 → 候选矩阵 → L0/L1/L2 解算 → Top10 校验）；L0 毫秒级广筛，纯 JS 零求解器依赖",
  "files": [
    "index.mjs",
    "cordis.patch.yml",
    "lib/",
    "tools/",
    "benchmarks/",
    "skills/",
    "models/",
    "scripts/",
    "docs/",
    "examples/",
    "CHANGELOG.md",
    "README.md",
    "LICENSE",
    "!models/experience",
    "!scripts/loss_calib*_result.json"
  ],
  "exports": {
    ".": "./index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "regression": "node scripts/regression.mjs",
    "update-baseline": "node scripts/regression.mjs --update-baseline"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.1.2 <0.2.0",
      "node": ">=22.0.0"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.2 <0.2.0"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "motor-design",
    "electric-motor",
    "electric-machine-design",
    "induction-motor",
    "asynchronous-motor",
    "pmsm",
    "permanent-magnet-synchronous-motor",
    "motor-sizing",
    "motor-selection",
    "electromagnetic-design",
    "motor-ai",
    "l0-estimate",
    "rmxprt",
    "motor-cad",
    "ansys",
    "电机设计",
    "永磁同步电机",
    "异步电机"
  ],
  "license": "MIT",
  "author": {
    "name": "wangxuewangxue98",
    "url": "https://github.com/wangxuewangxue98"
  },
  "contributors": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangxuewangxue98/dsh-motor-ai-l0.git"
  },
  "bugs": {
    "url": "https://github.com/wangxuewangxue98/dsh-motor-ai-l0/issues"
  },
  "homepage": "https://github.com/wangxuewangxue98/dsh-motor-ai-l0#readme"
}
