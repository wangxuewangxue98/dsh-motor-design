# Motor-AI 环境配置模板
# v1.03.01 引入双环境机制:
#   - 开发调试: 复制为 .env.dev  (MOTOR_ENV=dev,  port 5000)
#   - 发布试用: 复制为 .env.trial (MOTOR_ENV=trial, port 5001)
#   - 向后兼容: 也可复制为 .env (默认 dev 环境)
# 版本: 1.03.01 | 更新时间: 2026-07-27 22:00

# ---- 环境标识 (dev / trial) ----
MOTOR_ENV=dev

# ---- 系统版本 (三段式: 主版本.次版本.修订号) ----
SYSTEM_NAME=Motor-AI
SYSTEM_VERSION=1.03.01
VERSION_DATE=2026-07-27 22:00

# ---- Flask ----
FLASK_PORT=5000
FLASK_DEBUG=true
# 绑定地址: 127.0.0.1(仅本机) / 0.0.0.0(所有网卡) / 具体IP
BIND_HOST=127.0.0.1

# ---- 数据库 (按环境隔离) ----
# dev:   KnowledgeBase/designs_dev.db
# trial: KnowledgeBase/designs_trial.db
DB_PATH=D:\MotorDesign\KnowledgeBase\designs_dev.db

# ---- 本地模型 ----
OLLAMA_BASE_URL=http://127.0.0.1:11434
LOCAL_MODEL_NAME=qwen2.5:3b-instruct-q4_K_M
USE_GPU=true

# ---- 云端模型 (DeepSeek) ----
# 去 https://platform.deepseek.com/ 注册，充值 10 元，创建 API Key
# 填入下面的 sk-xxx，然后去掉前面的 #
# 注意: 试用版(.env.trial)中 ALLOW_CLOUD_API=false 会强制禁用云端
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
CLOUD_MODEL_NAME=deepseek-chat
ALLOW_CLOUD_API=true

# ---- Motor-CAD ----
MOTORCAD_EXE_PATH=D:\Motor-CAD\11_1_5\Motor-CAD_11_1_5.exe
MOTORCAD_INSTALL_DIR=D:\Motor-CAD\11_1_5
MOTORCAD_PROGID=MotorCAD.AppAutomation
# 使用模式: auto(自动COM求解)/manual(仅手动导入)/simulation(仅模拟)
MOTORCAD_USE_MODE=auto
MOTORCAD_TEMPLATE_FILE=Templates.mot

# ---- 多租户预留 (v1.03+ 未启用) ----
CLIENT_SECRET=
