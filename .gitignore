# ============================================================
# Motor-AI .gitignore
# ============================================================

# ---- Python ----
__pycache__/
*.pyc
*.pyo
*.pyd
venv/
.venv/

# ---- 运行时日志和临时文件 ----
Logs/
server.log
*.log
uploads/
exports/

# ---- 测试报告 (可重新生成) ----
Reports/com_diagnosis.json
Reports/motor_tools_integration_test.json
Reports/*.md
Reports/*.mot

# ---- 运行时数据 ----
data/
KnowledgeBase/*.db
KnowledgeBase/*.db-shm
KnowledgeBase/*.db-wal

# ---- Motor-CAD 仿真输出 ----
Templates/Templates/FEResultsData/

# ---- Motor-CAD 临时文件 ----
*.mot.tmp
*.mot.bak

# ---- IDE / 编辑器 ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- 操作系统 ----
Thumbs.db
desktop.ini
.DS_Store

# ---- Flask ----
instance/
.env.local

# ---- 环境配置 (含 API Key, 用 .env.example 作为模板) ----
.env
.env.dev
.env.trial
.env.local

# ---- 加密/备份 ----
*.zip
*.7z
*.rar
Releases/

# 1.4GB 运行期大文件，禁止入仓（2026-10-07 已从历史移除）
Scripts/control_map.json

# ---- 安全加固 (2026-10-12, 遗留②治理: 防密钥/数据库入仓) ----
# 根目录运行期数据库（之前未被 KnowledgeBase/*.db 覆盖，会随 git add -A 进仓）
motorai.db
*.db-wal
*.db-shm
# 含真实密钥的环境文件备份（.env.dev 本身已在上方忽略，但其 .bak 副本未覆盖）
.env*.bak*

# ---- 提交卫生 (2026-10-12, 遗留②: 提交 Core/Agents/app 时排除运行期/备份产物) ----
*.bak*
*.lock
Core/probe.txt
