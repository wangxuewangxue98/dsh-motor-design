# ============================================================
# Motor-AI .gitignore
# ============================================================

# ---- Python ----
__pycache__/
*.pyc
*.pyo
*.pyd
venv/
.venv/

# ---- 运行时日志和临时文件 ----
Logs/
server.log
*.log
uploads/
exports/

# ---- 测试报告 (可重新生成) ----
Reports/com_diagnosis.json
Reports/motor_tools_integration_test.json

# ---- Motor-CAD 临时文件 ----
*.mot.tmp
*.mot.bak

# ---- IDE / 编辑器 ----
.vscode/
.idea/
*.swp
*.swo
*~

# ---- 操作系统 ----
Thumbs.db
desktop.ini
.DS_Store

# ---- Flask ----
instance/
.env.local

# ---- 环境配置 (含 API Key, 用 .env.example 作为模板) ----
.env
.env.dev
.env.trial
.env.local

# ---- 加密/备份 ----
*.zip
*.7z
*.rar
Releases/
